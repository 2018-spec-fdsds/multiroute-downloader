#!/bin/bash
# Apple Installer runs this fixed package script as root, never the Java GUI.
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "$(id -u)" = 0 ] || exit 1
[ "${3:-}" = / ] || { printf '%s\n' 'Install MultiRoute Resume on the active system volume.' >&2; exit 1; }

verify_directory() {
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    [ "$(stat -f '%u' "$1")" = 0 ] || return 1
    local mode
    mode=$(stat -f '%Lp' "$1")
    [ "$((8#$mode & 0022))" = 0 ]
}

verify_directory /Library || { printf '%s\n' 'The system Library must be protected and root-owned.' >&2; exit 1; }
for component in /Library/PrivilegedHelperTools /Library/PrivilegedHelperTools/MultiRouteResume /Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@; do
    if [ -e "$component" ] || [ -L "$component" ]; then
        verify_directory "$component" || { printf '%s\n' 'The gateway installation path is not protected.' >&2; exit 1; }
    fi
done
for component in /Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-net /Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-net.sha256 /Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-launch /Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-launch.sha256; do
    if [ -e "$component" ] || [ -L "$component" ]; then
        [ -f "$component" ] && [ ! -L "$component" ] && [ "$(stat -f '%u' "$component")" = 0 ] || exit 1
        mode=$(stat -f '%Lp' "$component")
        [ "$((8#$mode & 0022))" = 0 ] || exit 1
    fi
done
[ -d /Applications ] && [ ! -L /Applications ] && [ "$(stat -f '%u' /Applications)" = 0 ] || exit 1
if [ -e '/Applications/MultiRoute Resume.app' ] || [ -L '/Applications/MultiRoute Resume.app' ]; then
    [ -d '/Applications/MultiRoute Resume.app' ] && [ ! -L '/Applications/MultiRoute Resume.app' ] || exit 1
fi
# No root user-home writes, launchctl changes, sudoers entries, BPF permission changes,
# system routes, Java installation outside the bundle, or app launch as root.
exit 0
