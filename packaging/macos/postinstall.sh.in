#!/bin/bash
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "$(id -u)" = 0 ] || exit 1
[ "${3:-}" = / ] || exit 1
helper='/Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-net'
marker='/Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-net.sha256'
launcher='/Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-launch'
launcher_marker='/Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@/gateway-launch.sha256'
expected='@HELPER_SHA256@'
launcher_expected='@LAUNCHER_SHA256@'
for component in /Library /Library/PrivilegedHelperTools /Library/PrivilegedHelperTools/MultiRouteResume /Library/PrivilegedHelperTools/MultiRouteResume/@VERSION@; do
    [ -d "$component" ] && [ ! -L "$component" ] && [ "$(stat -f '%u' "$component")" = 0 ] || exit 1
    mode=$(stat -f '%Lp' "$component")
    [ "$((8#$mode & 0022))" = 0 ] || exit 1
done
for component in "$helper" "$marker" "$launcher" "$launcher_marker"; do
    [ -f "$component" ] && [ ! -L "$component" ] && [ "$(stat -f '%u' "$component")" = 0 ] || exit 1
    mode=$(stat -f '%Lp' "$component")
    [ "$((8#$mode & 0022))" = 0 ] || exit 1
done
[ -x "$helper" ] || exit 1
[ "$(cat "$marker")" = "$expected" ] || exit 1
actual=$(shasum -a 256 "$helper")
actual=${actual%% *}
[ "$actual" = "$expected" ] || exit 1
[ -x "$launcher" ] && [ "$(cat "$launcher_marker")" = "$launcher_expected" ] || exit 1
actual=$(shasum -a 256 "$launcher")
actual=${actual%% *}
[ "$actual" = "$launcher_expected" ] || exit 1
"$helper" --self-test
"$launcher" --self-test
# BEGIN_DESKTOP_SHORTCUT_USER
create_user_desktop_shortcut() {
    local home="$1" expected_uid="$2" application="$3" desktop shortcut
    [ "$(/usr/bin/id -u)" = "$expected_uid" ] && [ "$expected_uid" != 0 ] || return 1
    [ -d "$home" ] && [ ! -L "$home" ] && [ "$(/usr/bin/stat -f '%u' "$home")" = "$expected_uid" ] || return 1
    [ -d "$application" ] && [ ! -L "$application" ] || return 1
    desktop="$home/Desktop"
    [ -d "$desktop" ] && [ ! -L "$desktop" ] && [ "$(/usr/bin/stat -f '%u' "$desktop")" = "$expected_uid" ] || return 1
    shortcut="$desktop/MultiRoute Downloader.app"
    # Keep any existing file, folder or link, including a broken link.
    [ ! -e "$shortcut" ] && [ ! -L "$shortcut" ] || return 0
    /bin/ln -s "$application" "$shortcut"
}
# END_DESKTOP_SHORTCUT_USER

create_desktop_shortcut() {
    local console_user console_uid home application='/Applications/MultiRoute Downloader.app'
    console_user=$(/usr/bin/stat -f '%Su' /dev/console) || return 1
    console_uid=$(/usr/bin/stat -f '%u' /dev/console) || return 1
    case "$console_user" in root|loginwindow|_mbsetupuser|''|*[!A-Za-z0-9._-]*) return 1 ;; esac
    case "$console_uid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$console_uid" -ge 500 ] && [ "$(/usr/bin/id -u "$console_user")" = "$console_uid" ] || return 1
    home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/sed -n 's/^NFSHomeDirectory: //p') || return 1
    case "$home" in /*) ;; *) return 1 ;; esac
    [[ "$home" != *$'\n'* ]] && [ "$home" != / ] || return 1
    [ -d "$application" ] && [ ! -L "$application" ] && [ "$(/usr/bin/stat -f '%u' "$application")" = 0 ] || return 1
    # The root installer never writes through a user's Desktop or home. All
    # shortcut checks and the ln operation run after sudo switches to that user.
    /usr/bin/sudo -n -H -u "$console_user" -- /bin/bash -c \
        "$(declare -f create_user_desktop_shortcut); create_user_desktop_shortcut \"\$@\"" \
        multiroute-desktop-shortcut "$home" "$console_uid" "$application"
}

if ! create_desktop_shortcut; then
    printf '%s\n' 'Desktop shortcut was not created during setup. The application will retry on its first graphical launch without replacing existing Desktop items.' >&2
fi
# Only the capture component needs graphical authorization later. The installer
# never starts Java as root and never writes a user's application state.
exit 0
